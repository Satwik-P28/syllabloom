{
  "name": "syllabloom",
  "version": "0.1.0",
  "private": true,
  "description": "Private local-first TTS reader for text, Markdown, and text-based PDFs.",
  "license": "MIT",
  "homepage": "https://syllabloom.nex3sss.chatgpt.site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Satwik-P28/syllabloom.git"
  },
  "bugs": {
    "url": "https://github.com/Satwik-P28/syllabloom/issues"
  },
  "keywords": [
    "text-to-speech",
    "speechify-alternative",
    "pdf-reader",
    "accessibility",
    "local-first",
    "open-source"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint app lib",
    "format": "oxfmt",
    "test": "vitest run --config vitest.config.ts",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "1.0.0-beta.9",
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.5.0",
    "lucide-react": "1.31.0",
    "pdfjs-dist": "6.3.289",
    "react-day-picker": "9.8.1",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.20.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@cloudflare/workers-types": "5.20260905.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "26.4.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "3.2.7",
    "wrangler": "4.122.0"
  },
  "type": "module"
}
